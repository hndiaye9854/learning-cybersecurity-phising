# Port d'écoute de l'application (dans le conteneur et en local)
PORT=3010

# Port publié sur l'hôte par docker compose (127.0.0.1 uniquement, relayé par nginx)
HOST_PORT=8130

# Mot de passe de la page /stats (Basic Auth, identifiant libre).
# Générez-en un avec : openssl rand -base64 24
ADMIN_TOKEN=change-moi-avec-une-valeur-longue-et-aleatoire

# (Optionnel) Emplacement du fichier de données
# DATA_FILE=data/submissions.json
